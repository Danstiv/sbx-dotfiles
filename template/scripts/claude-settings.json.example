{
  "model": "opus",
  "respondToBashCommands": false,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "prefersReducedMotion": true,
  "cleanupPeriodDays": 36500,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 3 -o /dev/null -X POST http://host.docker.internal:57919/play -H 'Content-Type: application/json' -d '{\"file_name\": \"stop.wav\"}' || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 3 -o /dev/null -X POST http://host.docker.internal:57919/play -H 'Content-Type: application/json' -d '{\"file_name\": \"prompt.wav\"}' || true"
          }
        ]
      }
    ]
  },
  "tui": "default",
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false
}
