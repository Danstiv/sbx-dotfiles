#!/usr/bin/env bash
# Restore a ~/.claude snapshot made by claude-backup.
#
# Extracts the archive over $HOME: files present in the archive overwrite their
# counterparts, anything not in the archive is left untouched (merge restore).
# Image-managed config is skipped even if the archive carries it (older
# archives do), so the config laid out by this image stays in force; see
# claude-backup-lib.sh.
# For a pristine restore, wipe first:  rm -rf ~/.claude && claude-restore <file>
#
#   claude-restore            <- newest archive in ./claude-backups/
#   claude-restore <dir>      <- newest archive in that directory
#   claude-restore <file>     <- exactly that archive
set -euo pipefail

source /opt/sbx/claude-backup-lib.sh

if [ $# -eq 0 ] || [ -d "${1:-}" ]; then
  DIR="${1:-$(get_default_dir)}"
  SRC=$(find_latest_archive "$DIR")
  if [ -z "$SRC" ]; then
    echo "restore: no claude-home-*.tar.gz in $DIR" >&2
    exit 1
  fi
else
  SRC="$1"
fi

if [ ! -f "$SRC" ]; then
  echo "restore: archive $SRC not found" >&2
  exit 1
fi

mapfile -t excludes < <(managed_excludes)
tar -xzf "$SRC" "${excludes[@]}" -C "$HOME"
echo "restore: $SRC -> $HOME/.claude"
