#!/usr/bin/env bash
# Snapshot ~/.claude into a tarball.
#
# The sandbox filesystem is ephemeral: only the workspace bind-mount survives a
# recreate. The default destination is a directory in the current directory,
# which inside the sandbox IS the mounted workspace — so the archives persist on
# the host. Each run writes its own timestamped file; an earlier archive is
# overwritten only if you name it explicitly.
#
# Image-managed config (settings.json, CLAUDE.md, the status line) is left out;
# see claude-backup-lib.sh.
#
#   claude-backup             -> ./claude-backups/claude-home-<date>-<time>.tar.zst
#   claude-backup <dir>       -> a timestamped file in that directory
#   claude-backup <file>      -> exactly that path
#
# ZSTD_LEVEL overrides the compression level.
set -euo pipefail

source /opt/sbx/claude-backup-lib.sh

SRC="$HOME/.claude"

# A trailing slash marks a directory that does not exist yet.
if [ $# -eq 0 ]; then
  DEST=$(build_archive_path "$(get_default_dir)")
elif [ -d "$1" ] || [ "$1" != "${1%/}" ]; then
  DEST=$(build_archive_path "$1")
else
  DEST="$1"
fi

if [ ! -d "$SRC" ]; then
  echo "backup: $SRC does not exist, nothing to back up" >&2
  exit 1
fi

mkdir -p "$(dirname "$DEST")"

mapfile -t excludes < <(managed_excludes)
# Level 10 is where the curve flattens on session logs: ~45% smaller than gzip
# and still under a second, while 19 costs ten times the time for another 10%.
tar -cf - "${excludes[@]}" -C "$HOME" .claude \
  | zstd -T0 "-${ZSTD_LEVEL:-10}" -q -f -o "$DEST"
echo "backup: $SRC -> $DEST ($(du -h "$DEST" | cut -f1))"
